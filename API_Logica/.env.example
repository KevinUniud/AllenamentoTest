# Docker Compose host port
API_PORT=5000

# Application runtime
LOG_LEVEL=INFO
DEFAULT_TIMEOUT=10
MAX_BATCH_SIZE=50
CORS_ORIGINS=http://localhost:12345,http://127.0.0.1:12345

# Optional local overrides for non-standard SWI-Prolog installations.
# SWI_PROLOG_PATH=/usr/bin/swipl
# PROLOG_DIR=/absolute/path/to/prolog
