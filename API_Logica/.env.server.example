# Identita del progetto e della release. Usare un tag nuovo per ogni deploy.
COMPOSE_PROJECT_NAME=testlogica-api-server
API_IMAGE_REPOSITORY=testlogica-api
RELEASE_TAG=replace-with-release-tag
RELEASE_REVISION=replace-with-git-revision

# Rete Docker condivisa esclusivamente con il reverse proxy Web.
BACKEND_NETWORK_NAME=testlogica-backend

# Configurazione applicativa. Sostituire il dominio di esempio.
LOG_LEVEL=INFO
DEFAULT_TIMEOUT=10
MAX_BATCH_SIZE=50
CORS_ORIGINS=https://logica.example.invalid

# Limiti e ciclo di vita del container.
API_STOP_GRACE_PERIOD=30s
API_TMPFS_SIZE=64m
API_PIDS_LIMIT=128
API_MEMORY_LIMIT=1g
API_MEMORY_RESERVATION=256m
API_CPUS=2.0
API_WORKERS=2
API_CONCURRENCY_LIMIT=16
API_BACKLOG=64
API_NOFILE_SOFT=1024
API_NOFILE_HARD=4096
API_LOG_MAX_SIZE=10m
API_LOG_MAX_FILES=5
DEPLOY_WAIT_TIMEOUT_SECONDS=180
# In produzione aggiorna sempre le immagini base; usare 0 soltanto nei test
# isolati/offline con una cache Docker gia verificata.
DEPLOY_PULL_BASE_IMAGES=1

# Rendere persistente questo percorso fuori da una directory di release che
# viene sostituita a ogni deploy. Crearlo come utente di deployment con 0700.
# Se omesso, gli script usano .deploy/ nella directory corrente del progetto.
# DEPLOY_STATE_DIR=/srv/testlogica/state/api

# Per impostazione predefinita l'API non pubblica porte sull'host.
# Abilitare questo override solo per diagnostica locale sul server.
API_ENABLE_LOOPBACK=0
API_LOOPBACK_ADDRESS=127.0.0.1
API_LOOPBACK_PORT=5000
