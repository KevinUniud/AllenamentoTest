{
  "name": "testlogica-web",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "prepare:public": "node tools/prepare-public.mjs",
    "predev": "npm run prepare:public",
    "dev": "next dev",
    "build": "npm run prepare:public && next build && node tools/generate-routes.mjs && node tools/generate-csp.mjs && npm run verify:export",
    "typecheck": "tsc --noEmit",
    "verify:export": "node tools/generate-csp.mjs --verify",
    "test:browser": "playwright test",
    "check": "node tools/check-js.mjs",
    "test": "node --test tests/*.test.js",
    "verify": "npm run check && npm test"
  },
  "dependencies": {
    "next": "16.3.6",
    "parse5": "8.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
