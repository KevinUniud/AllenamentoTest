# Copiare in .env.server, sostituire il tag e impostare permessi 0600.
COMPOSE_PROJECT_NAME=testlogica-web
RELEASE_TAG=replace-with-release-id
WEB_RELEASE_REVISION=replace-with-web-source-revision
FEEDBACK_RELEASE_REVISION=replace-with-feedback-source-revision
WEB_IMAGE_REPOSITORY=testlogica-web
FEEDBACK_IMAGE_REPOSITORY=testlogica-feedback

# Solo il reverse proxy TLS locale deve raggiungere questa porta.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=12345

# La API usa compose.server.yml nel repository fratello API_Logica e condivide
# questa rete Docker internal con alias DNS api-logica.
BACKEND_NETWORK_NAME=testlogica-backend
API_UPSTREAM=http://api-logica:5000
API_PROXY_TIMEOUT_SECONDS=125

# Usare i valori restituiti da: id -u ; id -g
FEEDBACK_UID=1000
FEEDBACK_GID=1000
# Percorso persistente assoluto, esterno a tutte le directory di release.
# La directory padre deve appartenere all'utente di deployment.
FEEDBACK_DATA_DIR=/srv/testlogica/shared/feedback-data
FEEDBACK_RETENTION_DAYS=365
FEEDBACK_MAX_BODY_BYTES=2097152
FEEDBACK_MAX_RECEIPTS=100000
FEEDBACK_MAX_STORAGE_BYTES=1073741824
FEEDBACK_MIN_FREE_BYTES=67108864
FEEDBACK_MIN_AGGREGATE_SESSIONS=10
FEEDBACK_SNAPSHOTS_TO_KEEP=3
FEEDBACK_PUBLISH_INTERVAL_SECONDS=86400
FEEDBACK_RETENTION_INTERVAL_SECONDS=3600
FEEDBACK_WORKER_HEARTBEAT_SECONDS=15
FEEDBACK_WORKER_STALE_SECONDS=60
FEEDBACK_WORKER_JOB_TIMEOUT_SECONDS=900
# Deve superare JOB_TIMEOUT almeno del tempo necessario a chiudere heartbeat e lock.
FEEDBACK_STOP_GRACE_SECONDS=960
FEEDBACK_CHARTS_REFRESH_SECONDS=300

# Limiti modificabili dopo una misura sul server effettivo.
WEB_MEMORY_LIMIT=256m
WEB_MEMORY_RESERVATION=64m
WEB_CPUS=0.5
FEEDBACK_HTTP_MEMORY_LIMIT=512m
FEEDBACK_HTTP_MEMORY_RESERVATION=128m
FEEDBACK_HTTP_CPUS=1.0
FEEDBACK_WORKER_MEMORY_LIMIT=1536m
FEEDBACK_WORKER_MEMORY_RESERVATION=512m
FEEDBACK_WORKER_CPUS=2.0

# Usati dagli script operativi, non passati ai container.
DEPLOY_WAIT_TIMEOUT=240
DEPLOY_STATE_DIR=/srv/testlogica/shared/state/web-feedback
# In produzione aggiorna le immagini base; usare 0 soltanto per collaudi offline.
DEPLOY_PULL_BASE_IMAGES=1
SMOKE_CONNECT_TIMEOUT=5
SMOKE_MAX_TIME=30

# Abilitare dopo avere configurato DNS, certificato e reverse proxy HTTPS.
# PUBLIC_BASE_URL=https://logica.example.org
