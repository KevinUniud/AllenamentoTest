# Porta HTTP pubblicata da Docker Compose.
WEB_PORT=12345

# API logica raggiunta da Nginx tramite host.docker.internal su Linux.
API_UPSTREAM=http://host.docker.internal:5000
API_PROXY_TIMEOUT_SECONDS=125

# Il servizio feedback non pubblica porte e gira dalla cartella sorella ../feedback.
# Usare i valori di `id -u` e `id -g`: i file nel bind mount resteranno eliminabili
# dal normale utente locale. I default 1000 sono corretti sulla maggior parte dei PC.
FEEDBACK_UID=1000
FEEDBACK_GID=1000
# Percorso relativo alla directory di questo Compose, oppure percorso assoluto.
# Crearlo come utente normale prima dell'avvio; Docker non lo crea automaticamente.
FEEDBACK_DATA_DIR=../feedback/data
FEEDBACK_RETENTION_DAYS=365
FEEDBACK_MAX_BODY_BYTES=2097152
FEEDBACK_MAX_RECEIPTS=100000
FEEDBACK_MAX_STORAGE_BYTES=1073741824
FEEDBACK_MIN_FREE_BYTES=67108864
FEEDBACK_MIN_AGGREGATE_SESSIONS=10
FEEDBACK_SNAPSHOTS_TO_KEEP=3
FEEDBACK_PUBLISH_INTERVAL_SECONDS=86400
FEEDBACK_RETENTION_INTERVAL_SECONDS=3600
FEEDBACK_WORKER_HEARTBEAT_SECONDS=15
# Deve essere strettamente maggiore del doppio di FEEDBACK_WORKER_HEARTBEAT_SECONDS.
FEEDBACK_WORKER_STALE_SECONDS=60
# Limite per un singolo ciclo di retention o generazione prima del riavvio.
FEEDBACK_WORKER_JOB_TIMEOUT_SECONDS=900
# Finestra concessa da Docker per terminare senza troncare un ciclo in corso.
FEEDBACK_STOP_GRACE_SECONDS=960

# Polling della galleria soltanto mentre la pagina e visibile (minimo 30 secondi).
FEEDBACK_CHARTS_REFRESH_SECONDS=300
